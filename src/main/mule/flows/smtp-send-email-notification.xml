<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:email="http://www.mulesoft.org/schema/mule/email" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd">
	
	<sub-flow name="smtp-send-email-notification-subflow" doc:id="8a835bec-04bd-45f9-b571-7e57a38a79ca" >
		<try doc:name="Try" doc:id="3fca473c-3bba-4513-bb67-ef58058c0369" >
			<until-successful maxRetries="${emailSMTP.retry.attempts}" doc:name="Until Successful" doc:id="4cbfba49-97e2-4519-b6b7-c6db5928f031" millisBetweenRetries="${emailSMTP.retry.frequency}">
				<email:send doc:name="Send" doc:id="2d4c1107-9330-41af-b560-b3a2fc19a549" toAddresses="#[(p('emailSMTP.toAddresses') splitBy &quot;,&quot;)]" config-ref="Email_SMTP" fromAddress="#[(p('emailSMTP.fromAddress'))]" ccAddresses="#[(p('emailSMTP.ccAddresses') splitBy &quot;,&quot;)]" subject='#[vars.emailContent.subject default "[]"]'>
					<email:body contentType="text/html" encoding="UTF-8">
						<email:content ><![CDATA[#[if(vars.isInvalidComm default false)
'<!DOCTYPE html>
<html>
  <body>
    <p>Hello &amp; Greetings,</p>
    <p>Invalid Records found in the Oracle WMS Source file, while syncing Store Level Inventory Data from Oracle WMS to SFCC.<br/>
    Please refer attached document for more details.</p>
    
    <p style="color:gray; font-size:small; font-style:italic;">
      This is an automated Email. Replies to this will not be monitored.
    </p>
    
    <p>Thanks &amp; Regards,<br/>
    Messaging Management Team</p>
  </body>
</html>'
else
	'<!DOCTYPE html>
<html>
  <body>
    <p>Hello &amp; Greetings,</p>
    <p>Invalid Records were found while syncing Store Level Inventory Data from Oracle WMS to SFCC.<br/>
    Please refer attached document for more details & take appropriate actions.</p>
    
    <p style="color:gray; font-size:small; font-style:italic;">
      This is an automated Email. Replies to this will not be monitored.
    </p>
    
    <p>Thanks &amp; Regards,<br/>
    Messaging Management Team</p>
  </body>
</html>']]]></email:content>
					</email:body>
					<email:attachments ><![CDATA[#[{
	"errorDetails.json" : write((vars.emailContent default {}),'application/json')
}]]]></email:attachments>
				</email:send>
			</until-successful>
			<error-handler >
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="6098c34a-eecb-4f10-aa4a-e473ed746463" >
					<logger level="ERROR" doc:name="log-error" doc:id="53a18f9b-8c54-4d9d-b2e3-a928330c72ea" message='#["SMTP Send Email errored out. TraceID : " ++ (vars.traceId default "")]'/>
				</on-error-continue>
			</error-handler>
		</try>
	</sub-flow>
</mule>
